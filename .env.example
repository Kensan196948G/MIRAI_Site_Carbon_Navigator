# MIRAI Site Carbon Navigator - environment variable reference
# Copy to .env and fill in real values. NEVER commit .env.

# --- Core ---
DATABASE_URL=sqlite:///./carbon_navigator.db
# PostgreSQL example: postgresql+psycopg2://mirai:mirai@db:5432/mirai_carbon
MIRAI_SECRET_KEY=replace-with-a-long-random-string
MIRAI_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://carbon.mirai-dx-platform.com
MIRAI_ENABLE_HSTS=0
MIRAI_RATE_LIMIT_PER_MIN=300

# --- Notifications ---
# MIRAI_SMTP_HOST=smtp.example.com
# MIRAI_SMTP_PORT=587
# MIRAI_SMTP_USER=user@example.com
# MIRAI_SMTP_PASSWORD=replace-me
# MIRAI_SMTP_FROM=noreply@example.com
# MIRAI_SMTP_TLS=1
# MIRAI_TEAMS_WEBHOOK=https://example.webhook.office.com/webhookb2/...

# --- Telematics ---
MIRAI_TELEMATICS_MODE=disabled
# MIRAI_KOMATSU_BASE_URL=https://api.example.com
# MIRAI_KOMATSU_API_KEY=replace-me

# --- SSO / OIDC ---
# MIRAI_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# MIRAI_OIDC_CLIENT_ID=replace-me
# MIRAI_OIDC_CLIENT_SECRET=replace-me
# MIRAI_OIDC_REDIRECT_URI=https://carbon.mirai-dx-platform.com/api/auth/oidc/callback
# MIRAI_FRONTEND_URL=https://carbon.mirai-dx-platform.com
