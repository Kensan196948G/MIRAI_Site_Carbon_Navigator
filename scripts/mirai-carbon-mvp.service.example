[Unit]
Description=MIRAI Site Carbon Navigator MVP Backend (uvicorn 127.0.0.1:8021, SQLite demo data)
Documentation=https://github.com/Kensan196948G/MIRAI_Site_Carbon_Navigator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kensan/Projects/Mirai-DX-Project/MIRAI_Site_Carbon_Navigator
ExecStart=/home/kensan/Projects/Mirai-DX-Project/MIRAI_Site_Carbon_Navigator/scripts/start_mvp.sh
Restart=always
RestartSec=10
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mirai-carbon-mvp

[Install]
WantedBy=default.target
